{
	"name": "n8n-nodes-stirling-pdf",
	"version": "0.1.0",
	"description": "n8n community node for Stirling-PDF: merge, split, convert, compress, OCR, secure and analyze PDFs",
	"license": "MIT",
	"homepage": "https://github.com/marcostoduto/n8n-nodes-stirling-pdf",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"stirling-pdf",
		"pdf",
		"ocr",
		"pdf-tools"
	],
	"author": {
		"name": "marcostoduto",
		"email": "marcostoduto@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/marcostoduto/n8n-nodes-stirling-pdf.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/StirlingPdfApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/StirlingPdf/StirlingPdf.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.57.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
